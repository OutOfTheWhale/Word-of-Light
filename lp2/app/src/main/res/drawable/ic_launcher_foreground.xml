<?xml version="1.0" encoding="utf-8"?>
<!--
  An open book with a ribbon marker. Drawn on the 108x108 adaptive-icon
  canvas with every stroke inside the centred 72x72 safe zone, so no
  launcher mask - circle, squircle or squared - can clip the ribbon tail.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left page. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M52 33 C46 28 38 26 32 26 C29 26 27 28 27 31 L27 59 C27 61 28 62 31 62 C38 62 46 64 52 68 Z" />
    <!-- Right page, mirrored about the spine at x=54. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M56 33 C62 28 70 26 76 26 C79 26 81 28 81 31 L81 59 C81 61 80 62 77 62 C70 62 62 64 56 68 Z" />
    <!-- Ribbon, hanging just right of the spine. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M61 70 L71 70 L71 84 L66 79 L61 84 Z" />
    <!-- Cover, open at the top so the pages read as pages. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M22 30 L22 65 C22 68 24 70 27 70 L81 70 C84 70 86 68 86 65 L86 30" />
</vector>
